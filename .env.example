# Live Mode is OFF by default. Copy to .env.local and fill in to enable.
# When enabled, /api/generate routes variants to Replicate instead of the
# library-backed compositor.

# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# The default model to call. See lib/orchestrator/model-router.ts for the
# full registry keyed by HexCoded vendor names.
REPLICATE_DEFAULT_MODEL=minimax/video-01
